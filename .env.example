# Ambiente de execução: development | production
APP_ENV=development

# Portas expostas no host
BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Postgres — credenciais do superuser (usado pelas migrations)
POSTGRES_USER=tevunah
POSTGRES_PASSWORD=tevunah
POSTGRES_DB=tevunah

# Roles separados criados pelo init script na primeira subida do Postgres
APP_DB_USER=tevunah_app
APP_DB_PASSWORD=tevunah_app
AUDIT_DB_USER=tevunah_audit_writer
AUDIT_DB_PASSWORD=tevunah_audit_writer

# Admin de desenvolvimento — criado por `./tevunah seed:dev` quando APP_ENV=development.
# Em produção este bloco NÃO é usado; use `./tevunah admin:create`.
DEV_ADMIN_EMAIL=admin@tevunah.local
DEV_ADMIN_NAME=Administrador Dev
DEV_ADMIN_PASSWORD=tevunah-dev-12345

# Importação de relatório de ocorrência: resolver o link curto do Google Maps
# para obter as coordenadas. Ligado por padrão; "off" desliga (o servidor
# deixa de fazer qualquer requisição ao Google e o analista informa o ponto
# manualmente).
INCIDENT_MAPS_RESOLVER=on

# Geocodificador: Nominatim da própria agência (OpenStreetMap), que localiza
# o endereço das ocorrências importadas do relatório operacional. Roda em
# máquina da agência: não tem custo por consulta nem conta em provedor
# externo, e nenhum endereço vai a terceiros. Vazio = desligado: a coordenada
# é só a que o analista informar, e a falta dela não vira pendência. Com URL,
# toda ocorrência sem coordenada fica pendente até ser localizada.
#   dev:  ./tevunah geo:up  e depois  GEOCODER_URL=http://nominatim:8080
#   prod: endereço do Nominatim na rede interna (ex.: http://192.168.100.x:8080)
# Depois de ligar, rode a geocodificação do acervo: ./tevunah geo:backfill
GEOCODER_URL=
# UF em que os endereços são procurados (evita a rua homônima de outro estado).
GEOCODER_STATE=Ceará
